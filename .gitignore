# --- build output -----------------------------------------------------------
# Everything here is produced by build.ps1 / CMake and is regenerated from
# scratch by a single command. It was 61 MB of the repository: object files,
# MSVC .tlog logs, the static lib, the executables, and a second copy of every
# asset that CMake stages next to the binary.
build/
out/
cmake-build-*/

# --- machine-local, not project state ---------------------------------------
# Written by the game on every exit: fullscreen, volumes, window size, the
# chosen avatar. One player's settings are not another's, and the file rebuilds
# itself with defaults when it is missing.
settings.json

# Working sheet regenerated by scripts/fit_card_art.py on every preview run.
# The script's own comment calls it a working file; it was 5.2 MB in the repo.
art_source/preview_fit.png

# --- captures ---------------------------------------------------------------
# F12 screenshots and anything the automation scripts leave behind.
screenshots/
*.png.tmp
vfx_arm_flare.png

# --- simulation and test scratch --------------------------------------------
# SanctumDuelSim and the other test binaries print to stdout; these are just
# redirections someone left on disk.
sim*.txt
s.txt
r.txt
rules.txt

# --- editor / OS ------------------------------------------------------------
.vs/
*.user
*.suo
Thumbs.db
desktop.ini
.DS_Store
